---
import { getTypeColor, getTypeTextClass } from "../../lib/pokemonTypeColors";

interface Props {
  type: string;
}

const { type } = Astro.props;
const color = getTypeColor(type);
const textClass = getTypeTextClass(type);
---

<span
  class:list={[
    "text-xs uppercase font-bold tracking-wide px-3 py-1 rounded-full",
    textClass,
  ]}
  style={`background-color: ${color}`}
>
  {type}
</span>
