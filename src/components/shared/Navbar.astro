---
const links = [
  { href: "/", label: "Home" },
  { href: "/pokedex", label: "Pokedex" },
  { href: "/moves", label: "Moves" },
  { href: "/abilities", label: "Abilities" },
  { href: "/items", label: "Items" },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);
---

<nav class="bg-white border-gray-200 shadow-sm sticky top-0 z-10">
  <div
    class="max-w-6xl flex flex-wrap items-center justify-between mx-auto p-4"
  >
    <a href="/" class="flex items-center space-x-2 rtl:space-x-reverse">
      <svg
        class="h-8 w-8"
        viewBox="0 0 128 128"
        xmlns="http://www.w3.org/2000/svg"
      >
        <circle cx="64" cy="64" r="60" fill="#fff" stroke="#1f2937" stroke-width="6" />
        <path d="M4 64a60 60 0 0 1 120 0Z" fill="#e3350d" stroke="#1f2937" stroke-width="6" />
        <line x1="4" y1="64" x2="124" y2="64" stroke="#1f2937" stroke-width="6" />
        <circle cx="64" cy="64" r="18" fill="#fff" stroke="#1f2937" stroke-width="6" />
        <circle cx="64" cy="64" r="7" fill="#fff" stroke="#1f2937" stroke-width="4" />
      </svg>
      <span class="self-center text-2xl font-semibold whitespace-nowrap text-gray-900"
        >Pokédex</span
      >
    </a>
    <button
      data-collapse-toggle="navbar-default"
      type="button"
      class="inline-flex items-center p-2 w-10 h-10 justify-center text-sm text-gray-500 rounded-lg md:hidden hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-gray-200"
      aria-controls="navbar-default"
      aria-expanded="false"
    >
      <span class="sr-only">Open main menu</span>
      <svg
        class="w-5 h-5"
        aria-hidden="true"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 17 14"
      >
        <path
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M1 1h15M1 7h15M1 13h15"></path>
      </svg>
    </button>
    <div class="hidden w-full md:block md:w-auto" id="navbar-default">
      <ul
        class="font-medium flex flex-col p-4 md:p-0 mt-4 border border-gray-100 rounded-lg bg-gray-50 md:flex-row md:space-x-8 rtl:space-x-reverse md:mt-0 md:border-0 md:bg-white"
      >
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isActive(link.href) ? "page" : undefined}
                class:list={[
                  "block py-2 px-3 rounded md:p-0 transition-colors",
                  isActive(link.href)
                    ? "text-white bg-red-600 md:bg-transparent md:text-red-600 font-semibold"
                    : "text-gray-900 hover:bg-gray-100 md:hover:bg-transparent md:hover:text-red-600",
                ]}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</nav>
