---
import { CapitalizeWord } from "../../lib/utils";
import { getChain, getPokemonbyName } from "../../services/PokemonSerice";
import { getTypeColor } from "../../lib/pokemonTypeColors";
import TypeBadge from "../shared/TypeBadge.astro";
import type { Pokemon } from "../../types/Pokemon";
import type { Specie } from "../../types/Specie";
import type { ChainElement } from "../../types/Chain";

interface Props {
  pokemon: Pokemon;
  specie: Specie;
}

const { pokemon, specie } = Astro.props;

const collectChainNames = (link: ChainElement): string[] => [
  link.species.name,
  ...link.evolves_to.flatMap(collectChainNames),
];

const chain = await getChain(specie.evolution_chain.url);
const chainNames = collectChainNames(chain.chain);
const evolutionChain = await Promise.all(
  chainNames.map((name) => getPokemonbyName(name))
);
const hasNoEvolutions = evolutionChain.length < 2;
---

<div class="rounded-2xl bg-white shadow-sm p-6 mt-8">
  <h2 class="font-semibold text-xl text-gray-900 mb-4">Cadena evolutiva</h2>
  {
    hasNoEvolutions ? (
      <p class="text-gray-500 text-sm">Este Pokémon no evoluciona.</p>
    ) : (
      <div class="flex flex-wrap items-center justify-center gap-4">
        {evolutionChain.map((pokemonChain, index) => {
          const isCurrent = pokemonChain.name === pokemon.name;
          const colorA = getTypeColor(pokemonChain.types[0]?.type.name);
          const colorB = getTypeColor(
            pokemonChain.types[1]?.type.name ?? pokemonChain.types[0]?.type.name
          );

          return (
            <Fragment>
              {index > 0 && <span class="text-2xl text-gray-300">→</span>}
              <a
                href={`/pokemon/${pokemonChain.name}`}
                class:list={[
                  "type-hover-card flex flex-col items-center rounded-2xl p-4 transition-shadow",
                  isCurrent ? "ring-2 ring-red-400 bg-red-50" : "bg-gray-50",
                ]}
                style={`--type-color-a: ${colorA}; --type-color-b: ${colorB};`}
              >
                <img
                  class="w-24 h-24 object-contain"
                  src={
                    pokemonChain.sprites.other?.["official-artwork"]
                      .front_default ?? undefined
                  }
                />
                <span class="font-semibold text-gray-900 mt-1">
                  {CapitalizeWord(pokemonChain.name)}
                </span>
                <div class="flex gap-1 mt-1">
                  {pokemonChain.types.map((type) => (
                    <TypeBadge type={type.type.name} />
                  ))}
                </div>
              </a>
            </Fragment>
          );
        })}
      </div>
    )
  }
</div>
