---
import Layout from "../layouts/Layout.astro";
import { ListPokedex } from "../components/pokedex/ListPokedex";
import { getPokemons, getPokemonbyName } from "../services/PokemonSerice";

const initialPokedex = await getPokemons(
  "https://pokeapi.co/api/v2/pokemon?offset=0&limit=20"
);
const initialPokemons = await Promise.all(
  initialPokedex.results.map((pokemon) => getPokemonbyName(pokemon.name))
);
const allPokemon = await getPokemons(
  "https://pokeapi.co/api/v2/pokemon?limit=100000&offset=0"
);
---

<Layout title="Pokedex">
  <ListPokedex
    client:load
    initialPokedex={initialPokedex}
    initialPokemons={initialPokemons}
    allPokemonNames={allPokemon.results}
  />
</Layout>
