---
import { CardPokemon } from "../../components/pokedex/CardPokemon";
import Layout from "../../layouts/Layout.astro";
import { CapitalizeWord } from "../../lib/utils";
import { getMovebyName, getPokemonbyName } from "../../services/PokemonSerice";
import { getTypeColor } from "../../lib/pokemonTypeColors";
import TypeBadge from "../../components/shared/TypeBadge.astro";

const { name } = Astro.params;
if (!name) return Astro.redirect("/moves");

const move = await getMovebyName(name);
const pokemons = await Promise.all(
  move.learned_by_pokemon.map((entry) => getPokemonbyName(entry.name))
);

const DAMAGE_CLASS_ICON: Record<string, string> = {
  physical:
    "https://images.wikidexcdn.net/mwuploads/wikidex/3/31/latest/20140504181227/Clase_f%C3%ADsico.gif",
  special:
    "https://images.wikidexcdn.net/mwuploads/wikidex/6/61/latest/20140504180925/Clase_especial.gif",
  status:
    "https://images.wikidexcdn.net/mwuploads/wikidex/0/06/latest/20141020094029/Clase_estado.gif",
};

const description = move.flavor_text_entries
  .filter((entry) => entry.language.name === "en")[0]
  ?.flavor_text.replace(/[\n\f]/g, " ");
---

<Layout title={CapitalizeWord(move.name)}>
  <div class="mb-6">
    <a
      href="/moves"
      class="py-2.5 px-5 rounded-full bg-white border border-gray-200 shadow-sm font-medium text-gray-700 hover:border-red-300 hover:text-red-600 hover:shadow-md transition"
    >
      ← Volver
    </a>
  </div>

  <div
    class="rounded-3xl shadow-sm p-8 mb-8"
    style={`background: linear-gradient(135deg, ${getTypeColor(move.type.name)}22, transparent 60%);`}
  >
    <div class="flex flex-col items-center text-center">
      <h1 class="text-4xl font-bold text-gray-900">
        {CapitalizeWord(move.name)}
      </h1>
      <div class="flex items-center gap-3 mt-3">
        <TypeBadge type={move.type.name} />
        <img
          class="w-8 h-8"
          src={DAMAGE_CLASS_ICON[move.damage_class.name]}
          title={move.damage_class.name}
        />
      </div>
      {description && (
        <p class="text-gray-600 italic mt-4 max-w-xl">"{description}"</p>
      )}
    </div>
    <div class="grid grid-cols-3 gap-4 mt-6 max-w-md mx-auto text-center">
      <div>
        <div class="text-xs uppercase text-gray-500">Power</div>
        <div class="font-semibold text-lg">{move.power ?? "—"}</div>
      </div>
      <div>
        <div class="text-xs uppercase text-gray-500">Accuracy</div>
        <div class="font-semibold text-lg">{move.accuracy ?? "—"}</div>
      </div>
      <div>
        <div class="text-xs uppercase text-gray-500">PP</div>
        <div class="font-semibold text-lg">{move.pp}</div>
      </div>
    </div>
  </div>

  <div class="rounded-2xl bg-white shadow-sm p-6">
    <h2 class="font-semibold text-xl text-gray-900 mb-4">
      Pokémon que aprenden este movimiento
    </h2>
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
      {pokemons.map((pokemon) => (
        <CardPokemon pokemon={pokemon} />
      ))}
    </div>
  </div>
</Layout>
