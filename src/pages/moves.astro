---
import { ListMoves } from "../components/move/ListMoves";
import Layout from "../layouts/Layout.astro";
import { getPokemons, getMovebyName } from "../services/PokemonSerice";

const initialMoveList = await getPokemons(
  "https://pokeapi.co/api/v2/move?offset=0&limit=20"
);
const initialMoves = await Promise.all(
  initialMoveList.results.map((move) => getMovebyName(move.name))
);
---

<Layout title="Movement List">
  <div class="text-center mb-8">
    <h1 class="text-4xl font-bold text-gray-900">Movimientos</h1>
    <p class="text-gray-600 mt-1">
      {initialMoveList.count} movimientos disponibles
    </p>
  </div>
  <ListMoves
    client:load
    baseUrl="https://pokeapi.co/api/v2/move"
    initialMoveList={initialMoveList}
    initialMoves={initialMoves}
  />
</Layout>
