---
import { CardPokemon } from "../../components/pokedex/CardPokemon";
import Layout from "../../layouts/Layout.astro";
import { CapitalizeWord } from "../../lib/utils";
import { getAbilitybyName, getPokemonbyName } from "../../services/PokemonSerice";

const { name } = Astro.params;
if (!name) return Astro.redirect("/abilities");

const ability = await getAbilitybyName(name);
const pokemons = await Promise.all(
  ability.pokemon.map((entry) => getPokemonbyName(entry.pokemon.name))
);

const description = ability.effect_entries.filter(
  (entry) => entry.language.name === "en"
)[0]?.effect;
---

<Layout title={CapitalizeWord(name)}>
  <div class="mb-6">
    <a
      href="/abilities"
      class="py-2.5 px-5 rounded-full bg-white border border-gray-200 shadow-sm font-medium text-gray-700 hover:border-red-300 hover:text-red-600 hover:shadow-md transition"
    >
      ← Volver
    </a>
  </div>

  <div class="rounded-3xl bg-white shadow-sm p-8 mb-8 text-center">
    <h1 class="text-4xl font-bold text-gray-900">{CapitalizeWord(name)}</h1>
    <p class="text-gray-600 italic mt-4 max-w-xl mx-auto">
      {description ?? "Sin descripción disponible."}
    </p>
  </div>

  <div class="rounded-2xl bg-white shadow-sm p-6">
    <h2 class="font-semibold text-xl text-gray-900 mb-4">
      Pokémon con esta habilidad
    </h2>
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
      {pokemons.map((pokemon) => (
        <CardPokemon pokemon={pokemon} />
      ))}
    </div>
  </div>
</Layout>
