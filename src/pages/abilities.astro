---
import { ListAbilities } from "../components/ability/ListAbilities";
import Layout from "../layouts/Layout.astro";
import { getPokemons, getAbilitybyName } from "../services/PokemonSerice";

const initialAbilityList = await getPokemons(
  "https://pokeapi.co/api/v2/ability?offset=0&limit=20"
);
const initialAbilities = await Promise.all(
  initialAbilityList.results.map((ability) => getAbilitybyName(ability.name))
);
---

<Layout title="Abilities List">
  <div class="text-center mb-8">
    <h1 class="text-4xl font-bold text-gray-900">Habilidades</h1>
    <p class="text-gray-600 mt-1">
      {initialAbilityList.count} habilidades disponibles
    </p>
  </div>
  <ListAbilities
    client:load
    baseUrl="https://pokeapi.co/api/v2/ability"
    initialAbilityList={initialAbilityList}
    initialAbilities={initialAbilities}
  />
</Layout>
