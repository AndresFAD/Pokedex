---
import Navbar from "../components/shared/Navbar.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Pokedex: explora Pokemon, movimientos, habilidades y objetos." />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link
      href="https://cdn.jsdelivr.net/npm/flowbite@2.4.1/dist/flowbite.min.css"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-app">
    <Navbar />
    <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 my-6">
      <slot />
    </main>
  </body>
  <script src="https://cdn.jsdelivr.net/npm/flowbite@2.4.1/dist/flowbite.min.js"
  ></script>
  <style is:global>
    @import url("https://fonts.googleapis.com/css2?family=Dosis:wght@200..800&family=Noto+Serif:ital,wght@0,100..900;1,100..900&display=swap");
    * {
      font-family: "Dosis", sans-serif;
      font-optical-sizing: auto;
      font-style: normal;
    }

    .bg-app {
      background-color: #f8fafc;
      background-image:
        radial-gradient(circle at 15% 10%, rgba(239, 68, 68, 0.08), transparent 42%),
        radial-gradient(circle at 85% 0%, rgba(59, 130, 246, 0.08), transparent 40%),
        radial-gradient(circle at 50% 100%, rgba(250, 204, 21, 0.07), transparent 45%);
      background-attachment: fixed;
    }

    /* Renders a diffused neon-style glow on hover: --type-color-a bleeds from
       the left, --type-color-b from the right. For single-type cards both
       variables are the same color, so the glow reads as one even halo. The
       glow is a box-shadow (not border-image) so it follows border-radius
       and stays soft/rounded instead of a hard-edged split line. */
    .type-hover-card {
      border: 3px solid transparent;
      border-radius: 1rem;
      transition: transform 0.25s ease, box-shadow 0.3s ease;
    }
    .type-hover-card:hover {
      transform: translateY(-4px);
      box-shadow:
        -10px 0 28px -8px var(--type-color-a, #d1d5db),
        10px 0 28px -8px var(--type-color-b, #d1d5db),
        0 6px 20px -6px rgba(0, 0, 0, 0.25);
    }
  </style>
</html>
